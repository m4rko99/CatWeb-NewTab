{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "1.0.0",
  "description": "A dark, minimal new tab page with a search bar and your own shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["favicon", "search"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
